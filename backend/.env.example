# Copy to backend/.env (scripts/devdb.ps1 init generates it for you).
POSTGRES_SUPERUSER_PASSWORD=change-me
LIFEOS_DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://lifeos:change-me@localhost:5432/lifeos
# Used by scripts/dev.ps1 instead of DATABASE_URL, so development never touches real data.
DEV_DATABASE_URL=postgresql+asyncpg://lifeos:change-me@localhost:5432/lifeos_dev
TEST_DATABASE_URL=postgresql+asyncpg://lifeos:change-me@localhost:5432/lifeos_test
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Optional
# ENVIRONMENT=dev
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# CORS_ORIGINS=["http://localhost:5173"]
